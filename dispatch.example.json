{
  "providers": {
    "claude": {
      "name": "claude",
      "command": "claude",
      "baseArgs": ["-p", "--output-format", "json", "--dangerously-skip-permissions", "--system-prompt", "You are a helpful assistant on Matrix chat. Keep responses under 10 lines. Use markdown formatting. Be direct and concise."],
      "messageFlag": "positional",
      "resumeFlag": "--resume",
      "outputFormat": "json",
      "responsePath": "result",
      "sessionIdPath": "session_id",
      "cwd": "/path/to/your/repos",
      "timeout": 600000
    }
  },
  "bots": [
    {
      "name": "gary",
      "provider": "claude",
      "matrixUserId": "@gary:your.matrix.server",
      "matrixAccessToken": "YOUR_ACCESS_TOKEN",
      "matrixHomeserver": "https://your.matrix.server",
      "rooms": [],
      "ignoreSenders": ["@other-bot:your.matrix.server"]
    },
    {
      "name": "clark",
      "provider": "claude",
      "matrixUserId": "@clark:your.matrix.server",
      "matrixAccessToken": "YOUR_ACCESS_TOKEN",
      "matrixHomeserver": "https://your.matrix.server",
      "rooms": [],
      "ignoreSenders": ["@other-bot:your.matrix.server"]
    }
  ]
}
